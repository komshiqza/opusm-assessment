# =====================================================================
# opusm assessment: environment
#   cp .env.example .env.local
#   then set CANDIDATE_ID (the only value you have to change)
# =====================================================================
#
# These SAP FSM credentials are intentionally public. They belong to a demo
# company that contains only seeded test data, and they will be revoked after
# the deadline (21.11.2026 23:59 CET). Do not reuse them for anything else.
#
# Everything without the NEXT_PUBLIC_ prefix stays on the server. The pre-built
# proxy (/api/fsm/...) adds the token, so the browser never sees the secret.
# Keep it that way.

# --- Your identity in the shared company -----------------------------------
# Lowercase letters, digits and dashes, 3-20 chars. Use your GitHub username.
# Every skill (Tag) you create must start with "<CANDIDATE_ID>::", see ASSIGNMENT.md.
NEXT_PUBLIC_CANDIDATE_ID=

# --- SAP FSM OAuth client (client_credentials) ------------------------------
FSM_AUTH_URL=https://eu.fsm.cloud.sap/api/oauth2/v1/token
FSM_CLIENT_ID=0001531a-opusm-assessment
FSM_CLIENT_SECRET=8bcc9569-ebdc-488c-b540-ad866e57b76e
FSM_ACCOUNT_ID=86810
FSM_COMPANY_ID=112212
